#%RAML 1.0
title: Customer Lookup API
version: v1
mediaType: application/json
baseUri: http://localhost:8081/api/customer-lookup

types:
  CustomerSummary:
    type: object
    additionalProperties: false
    properties:
      customerId:
        type: string
        pattern: ^CUST-[0-9]{3}$
      displayName: string
      status:
        enum: [ACTIVE, INACTIVE]
      segment:
        enum: [STANDARD, PREMIUM]
      lastUpdated:
        type: datetime
    example:
      customerId: CUST-001
      displayName: Ada Lovelace
      status: ACTIVE
      segment: PREMIUM
      lastUpdated: 2026-09-14T00:00:00Z
  ErrorResponse:
    type: object
    additionalProperties: false
    properties:
      error:
        type: object
        additionalProperties: false
        properties:
          code: integer
          reason: string
          message: string
    example:
      error:
        code: 400
        reason: Bad Request
        message: The requested customer cannot be returned.

/customers/{customerId}:
  uriParameters:
    customerId:
      type: string
      pattern: ^CUST-[0-9]{3}$
      example: CUST-001
  get:
    description: Returns an active synthetic customer summary. Invalid, unknown, or inactive customers are business errors (400).
    responses:
      200:
        headers:
          x-correlation-id: string
        body:
          application/json:
            type: CustomerSummary
      400:
        description: Invalid, unknown, or inactive customer.
        body:
          application/json:
            type: ErrorResponse
      404:
        description: The requested API endpoint does not exist.
        body:
          application/json:
            type: ErrorResponse
      500:
        body:
          application/json:
            type: ErrorResponse
      405:
        description: Method not allowed for the requested endpoint.
        body:
          application/json:
            type: ErrorResponse
      406:
        description: No acceptable representation is available.
        body:
          application/json:
            type: ErrorResponse
      415:
        description: Unsupported request media type.
        body:
          application/json:
            type: ErrorResponse
